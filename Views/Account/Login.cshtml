@model ShuttlOps.ViewModel.Auth.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign In - ShuttlOps";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
    <link href="~/lib/sweetalert/sweetalert2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <script src="~/lib/sweetalert/sweetalert2.min.js"></script>
</head>
<body class="login-body">
    <main class="auth-shell d-flex align-items-center justify-content-center">
        <div class="auth-panel row g-0">
            <section class="auth-aside col-md-5 d-none d-md-flex flex-column" aria-label="ShuttlOps portal overview">
                <div class="auth-brand">
                    <div class="d-flex align-items-center gap-3">
                        <span class="auth-brand-mark fs-5"><i class="bi bi-bus-front-fill"></i></span>
                        <span class="fw-bold fs-5">ShuttlOps</span>
                    </div>
                    <div class="auth-kicker mt-5 mb-2">Mobility operations portal</div>
                    <h2 class="fw-bold lh-sm mb-3">Keep every journey moving with confidence.</h2>
                    <p class="mb-0 text-white-50">Plan, approve, and manage company transportation from one secure workspace.</p>
                </div>
                <ul class="auth-feature-list mt-auto">
                    <li><i class="bi bi-check-circle-fill"></i> Centralized trip request management</li>
                    <li><i class="bi bi-check-circle-fill"></i> Live dispatch visibility</li>
                    <li><i class="bi bi-check-circle-fill"></i> Role-based operational access</li>
                </ul>
            </section>

            <section class="auth-form-side col-md-7 d-flex align-items-center justify-content-center p-4 p-md-5">
                <div class="auth-form-wrap">
                    <div class="mb-4">
                        <div class="auth-kicker text-primary mb-2">Secure sign in</div>
                        <h1 class="fw-bold mb-2">Welcome back</h1>
                        <p class="text-muted mb-0">Enter your corporate credentials to access the portal.</p>
                    </div>
                    <form asp-controller="Auth" asp-action="LoggedIn" method="post" id="LoginForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <div class="form-floating mb-3">
                            <input asp-for="UsernameInput" class="form-control" placeholder="Corporate ID" autocomplete="username" required />
                            <label asp-for="UsernameInput"><i class="bi bi-person-badge me-2"></i>Corporate ID</label>
                            <span asp-validation-for="UsernameInput" class="text-danger small"></span>
                        </div>
                        <div class="form-floating mb-3">
                            <input asp-for="PasswordInput" type="password" class="form-control" placeholder="Password" autocomplete="current-password" required />
                            <label asp-for="PasswordInput"><i class="bi bi-lock me-2"></i>Password</label>
                            <span asp-validation-for="PasswordInput" class="text-danger small"></span>
                        </div>
                        <div class="d-flex justify-content-end mb-4">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="text-decoration-none text-primary small fw-semibold">Forgot password?</a>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 fw-bold btn-login">Sign in to ShuttlOps <i class="bi bi-arrow-right ms-2"></i></button>
                    </form>
                    <p class="auth-security-note text-center mt-4 mb-0"><i class="bi bi-shield-check me-1"></i> Authorized personnel only · ShuttlOps Portal &copy; @DateTime.Now.Year</p>
                </div>
            </section>
        </div>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js"></script>
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
