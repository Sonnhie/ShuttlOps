@* ﻿@model RFQApp.Models.LoginViewModel *@
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShuttlOps</title>
    <link rel="icon" type="image/png" href="~/img/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <div class="container-fluid vh-100 d-flex justify-content-center align-items-center" style="background-color: #f3f4f6;">

        <div class="card border-0 shadow-lg overflow-hidden rounded-5" style="width: 100%; max-width: 950px;">
            <div class="row g-0 h-100">

                <div class="col-md-6 d-none d-md-flex flex-column justify-content-between p-5 text-white" style="background-color: #0A2342;">

                    <img src="~/img/brand.png" alt="Company Logo" class="img-fluid mb-4 rounded-3 p-2 shadow-sm" style="max-height: 140px; width: 140px; object-fit: contain;" />

                    <div>
                        <h2 class="fw-bold mb-3">RFQ System</h2>
                        <p class="text-white-50 small">Automated manufacturing procurement, precision analytics, and supplier quotation control.</p>
                    </div>

                    <div class="small text-white-50" style="font-size: 0.75rem;">
                        &copy; 2026 Nidec Instruments Philippines Corporation.
                    </div>
                </div>

                <div class="col-12 col-md-6 d-flex flex-column justify-content-center bg-white p-4 p-md-5">
                    <div class="w-100 mx-auto" style="max-width: 380px;">

                        <div class="text-center d-md-none mb-4">
                            <img src="~/img/brand.png" alt="Company Logo" class="img-fluid rounded" style="max-height: 60px; object-fit: contain;" />
                        </div>

                        <div class="mb-4">
                            <h3 class="fw-bolder text-dark mb-1">Sign In</h3>
                            <p class="text-muted small">Access your secure enterprise portal.</p>
                        </div>

                        @* <form asp-controller="Login" asp-action="LoggedIn" method="post" id="loginform">

                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-dark small text-uppercase tracking-wide" style="font-size: 0.8rem;">Corporate ID</label>
                                <input type="text"
                                       asp-for = "UserName"
                                       class="form-control form-control-lg bg-light border-0 fs-6"
                                       placeholder=""
                                       required>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="form-label fw-semibold text-dark small text-uppercase" style="font-size: 0.8rem;">Password</label>
                                </div>
                                <input type="password" asp-for ="Password" class="form-control form-control-lg bg-light border-0 fs-6" placeholder="••••••••" required>
                                <span asp-validation-for = "Password" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm mb-3 fs-6">
                                Sign In
                            </button>
                        </form> *@

                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/Login.js" asp-append-version="true"></script>
</body>
</html>