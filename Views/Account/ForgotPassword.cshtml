@{
    Layout = null;
    ViewData["Title"] = "Password Reset - ShuttlOps";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body class="login-body">
    <main class="auth-shell d-flex align-items-center justify-content-center">
        <section class="auth-panel p-4 p-md-5 d-flex align-items-center justify-content-center" style="min-height: 460px;">
            <div class="auth-form-wrap text-center">
                <span class="auth-brand-mark bg-primary text-white border-0 mb-4"><i class="bi bi-shield-lock fs-5"></i></span>
                <div class="auth-kicker text-primary mb-2">Account support</div>
                <h1 class="fw-bold mb-3">Password reset</h1>
                <p class="text-muted mb-4">For your security, password resets are handled by your ShuttlOps administrator. Please contact your administrator to regain access.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 btn-login d-inline-flex align-items-center justify-content-center">Return to sign in <i class="bi bi-arrow-right ms-2"></i></a>
            </div>
        </section>
    </main>
</body>
</html>
