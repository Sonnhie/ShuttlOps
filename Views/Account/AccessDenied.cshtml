@{
    ViewData["Title"] = "Access Restricted";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 180px);">
    <section class="card text-center p-4 p-md-5" style="max-width: 520px;">
        <span class="section-icon mx-auto mb-4" style="width: 58px; height: 58px; font-size: 1.5rem;"><i class="bi bi-shield-lock"></i></span>
        <div class="eyebrow mb-2">Permission required</div>
        <h1 class="h3 fw-bold mb-3">You don’t have access to this page</h1>
        <p class="text-muted mb-4">Your current role does not include the permission required to view this resource. Contact your administrator if you believe this is incorrect.</p>
        <a href="~/" class="btn btn-primary px-4 mx-auto">Return to dashboard</a>
    </section>
</div>
