@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "Security & Attendance Logs";
}

<div class="d-flex flex-column gap-4 mb-4">
    <!-- Header -->
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3">
        <div>
            <div class="eyebrow mb-1">Attendance Tracking & Gate Security</div>
            <h1 class="fw-bold mb-1">Security & Attendance Logs</h1>
            <p class="mb-0 text-muted">Gate clearance verification, passenger manifest attendance, and live dispatch arrival/departure logs.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button type="button" class="btn btn-sm btn-outline-primary px-3" id="btnRefreshSecurityLogs">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Logs
            </button>
            <a asp-controller="User" asp-action="ScheduleCalendar" class="btn btn-sm btn-primary px-3">
                <i class="bi bi-calendar-week me-1"></i> Schedule Calendar
            </a>
        </div>
    </div>

    <!-- Quick Status Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center text-warning" style="width: 48px; height: 48px;">
                    <i class="bi bi-shield-exclamation fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Awaiting Gate Clearance</div>
                    <div class="fs-4 fw-bold text-dark" id="secAwaitingCount">—</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary" style="width: 48px; height: 48px;">
                    <i class="bi bi-bus-front fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Active On Road</div>
                    <div class="fs-4 fw-bold text-dark" id="secActiveCount">—</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center text-success" style="width: 48px; height: 48px;">
                    <i class="bi bi-shield-check fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Cleared & Completed</div>
                    <div class="fs-4 fw-bold text-dark" id="secClearedCount">—</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 d-flex align-items-center justify-content-center text-info" style="width: 48px; height: 48px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem;">Verified Passengers</div>
                    <div class="fs-4 fw-bold text-dark" id="secPaxCount">—</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Attendance & Security Logs Table Card -->
    <section class="card schedule-tabs-card">
        <div class="card-header p-0">
            <nav class="schedule-tabs" aria-label="Security filter tabs">
                <div class="nav nav-tabs flex-nowrap overflow-auto" id="secStatusTabs" role="tablist">
                    <button class="nav-link active" id="all-sec-tab" data-bs-toggle="tab" data-bs-target="#sec-log-panel" data-status="" type="button" role="tab" aria-selected="true">
                        <i class="bi bi-grid-3x3-gap me-2"></i>All Manifests
                    </button>
                    <button class="nav-link" id="awaiting-sec-tab" data-bs-toggle="tab" data-bs-target="#sec-log-panel" data-status="Ready for Dispatch" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-hourglass-split me-2"></i>Awaiting Clearance
                    </button>
                    <button class="nav-link" id="active-sec-tab" data-bs-toggle="tab" data-bs-target="#sec-log-panel" data-status="GA Approved" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-shield-shaded me-2"></i>Approved Dispatches
                    </button>
                    <button class="nav-link" id="completed-sec-tab" data-bs-toggle="tab" data-bs-target="#sec-log-panel" data-status="Completed" type="button" role="tab" aria-selected="false">
                        <i class="bi bi-check2-circle me-2"></i>Gate Clearance Completed
                    </button>
                </div>
            </nav>
        </div>

        <div class="tab-content" id="secStatusTabContent">
            <div class="tab-pane fade show active" id="sec-log-panel" role="tabpanel" tabindex="0">
                <div class="card-body p-0">
                    <div class="d-flex justify-content-between align-items-center px-4 pt-4 pb-2 gap-3 flex-wrap">
                        <div>
                            <h2 class="card-title fw-bold mb-0">Gate Manifest & Attendance Directory</h2>
                            <span class="text-muted small">Verify passenger manifests and record departure/arrival timestamps</span>
                        </div>
                    </div>
                    <div class="table-responsive m-3 mt-2">
                        <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                                 model='new ReusableTableDTO {
                                     TableHeaders = new List<string> { "Ticket Number", "Trip Date", "Time", "Driver", "Route", "Passenger Attendance", "Security Status", "Action" },
                                     TableId = "SecurityLogsTable"
                                 }' />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Gate Clearance Verification Modal -->
    <div class="modal fade" id="gateClearanceModal" tabindex="-1" aria-labelledby="gateClearanceModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="gateClearanceModalTitle">
                        <i class="bi bi-shield-check text-primary me-2"></i>Gate Clearance Verification
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="gateClearanceForm">
                    <div class="modal-body p-4">
                        <input type="hidden" id="clearanceTicketId" />
                        <div class="alert alert-primary py-2 px-3 small mb-3">
                            <span class="fw-bold" id="clearanceTicketNumber">REQ-00000000-0000</span> — <span id="clearanceRoute">Route info</span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Assigned Driver & Vehicle</label>
                            <div class="form-control bg-light" id="clearanceDriverVehicle">Driver / Vehicle</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-muted">Passenger Manifest Checklist</label>
                            <div id="clearancePassengerList" class="p-3 border rounded-3 bg-light d-flex flex-column gap-2" style="max-height: 150px; overflow-y: auto;">
                                <!-- Passenger checkboxes dynamically populated -->
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="guardId" class="form-label small fw-semibold text-muted">Guard ID</label>
                                <input type="text" id="guardIdInput" class="form-control form-control-sm" placeholder="Security Guard ID Number" required />
                            </div>
                            <div class="col-6">
                                <label for="ArrivalTime" class="form-label small fw-semibold text-muted">Arrival Time</label>
                                <input type="datetime-local" id="arrivalTimeInput" class="form-control form-control-sm"/>
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label for="guardNameInput" class="form-label small fw-semibold text-muted">Guard Signature / Name</label>
                                <input type="text" id="guardNameInput" class="form-control form-control-sm" placeholder="Security Guard Name" required />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="odometerInput" class="form-label small fw-semibold text-muted">Odometer Reading From(km)</label>
                                <input type="number" id="odometerInputStart" class="form-control form-control-sm" placeholder="e.g. 45200" />
                            </div>
                            <div class="col-6">
                                <label for="odometerInput" class="form-label small fw-semibold text-muted">Odometer Reading To(km)</label>
                                <input type="number" id="odometerInputEnd" class="form-control form-control-sm" placeholder="e.g. 45200" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="guardRemarksInput" class="form-label small fw-semibold text-muted">Security Notes / Gate Remarks</label>
                            <textarea id="guardRemarksInput" class="form-control form-control-sm" rows="2" placeholder="Inspection remarks, delayed passenger notes, etc."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success px-4" id="btnConfirmGateClearance">
                            <i class="bi bi-check-lg me-1"></i> Sign & Clear Gate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SecurityLogs.js" asp-append-version="true"></script>
}




