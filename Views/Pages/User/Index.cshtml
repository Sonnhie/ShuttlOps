@{
    ViewData["Title"] = "Requestor Dashboard";
}

<section id="user-dashboard" class="user-dashboard" aria-label="Trip request operations workspace">
    <!-- Portal Page Header (same theme as GA workspace) -->
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3 mb-0">
        <div>
            <div class="eyebrow mb-1">Mobility Operations</div>
            <h1 class="fw-bold mb-1">Trip request dashboard</h1>
            <p class="mb-0">Track shuttle requests, approval workflows, and upcoming trips. Use Schedule Calendar for the shared monthly view.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="User" asp-action="ScheduleCalendar" class="btn btn-light">
                <i class="bi bi-calendar3 me-2"></i>Schedule calendar
            </a>
            <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Create trip ticket
            </a>
        </div>
    </div>

    <div class="workspace-panel mt-4">
        <!-- Metric Summary Cards (identical styling to GA workspace) -->
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#1769e0">
                    <span class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-ticket-perforated fs-5"></i></span>
                    <div>
                        <div class="metric-label">Total submitted</div>
                        <div class="metric-value mt-1" id="userTotalCount">—</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#e69a16">
                    <span class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-hourglass-split fs-5"></i></span>
                    <div>
                        <div class="metric-label">Awaiting approval</div>
                        <div class="metric-value mt-1" id="userPendingCount">—</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#198754">
                    <span class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-calendar-check fs-5"></i></span>
                    <div>
                        <div class="metric-label">Approved trips</div>
                        <div class="metric-value mt-1" id="userApprovedCount">—</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#19a7ce">
                    <span class="metric-icon bg-info bg-opacity-10 text-info"><i class="bi bi-check2-circle fs-5"></i></span>
                    <div>
                        <div class="metric-label">Completed trips</div>
                        <div class="metric-value mt-1" id="userCompletedCount">—</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Content Row: Upcoming / Recent Dispatches & Quick Actions -->
        <div class="row g-4 mt-1">
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon"><i class="bi bi-clock-history"></i></span>
                            <div>
                                <h2 class="card-title fw-bold mb-0">Upcoming & recent requests</h2>
                                <span class="text-muted small">Your latest shuttle trip tickets and approval statuses</span>
                            </div>
                        </div>
                        <a asp-controller="User" asp-action="TripSchedule" class="btn btn-sm btn-light">View all tickets</a>
                    </div>
                    <div class="card-body p-0">
                        <div id="userUpcomingTrips" class="ga-upcoming-list">
                            <div class="text-muted text-center py-5">
                                <span class="spinner-border spinner-border-sm me-2"></span>Loading trip requests…
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card h-100">
                    <div class="card-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon"><i class="bi bi-lightning-charge"></i></span>
                            <div>
                                <h2 class="card-title fw-bold mb-0">Quick actions</h2>
                                <span class="text-muted small">Request and schedule shortcuts</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a asp-controller="User" asp-action="CreateTicketPage" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-plus-circle"></i></span>
                            <span><strong>Create trip ticket</strong><small>Submit a new shuttle reservation</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                        <a asp-controller="User" asp-action="TripSchedule" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-list-check"></i></span>
                            <span><strong>Trip schedule directory</strong><small>Review section requests and approval status</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                        <a asp-controller="User" asp-action="ScheduleCalendar" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-calendar-week"></i></span>
                            <span><strong>Schedule calendar</strong><small>Shared monthly and daily dispatch calendar</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                        <a asp-controller="User" asp-action="Analytics" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-graph-up"></i></span>
                            <span><strong>Trip analytics</strong><small>Review section usage and trip statistics</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/UserDashboard.js" asp-append-version="true"></script>
}
