@{
    ViewData["Title"] = "Requestor Dashboard";
}

<div class="d-flex flex-column gap-4">
    <!-- Welcome Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 bg-primary text-white overflow-hidden position-relative">
        <div class="card-body p-4 p-lg-5 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="z-1">
                <span class="badge bg-white bg-opacity-20 text-white mb-2 px-3 py-1.5 rounded-pill fw-semibold">
                    <i class="bi bi-speedometer2 me-1"></i> Requestor Overview
                </span>
                <h1 class="h2 fw-bold mb-1">Welcome back, @(User.Identity?.Name ?? "User")!</h1>
                <p class="mb-0 text-white-50">Manage your shuttle tickets, track approval statuses, and view upcoming trips.</p>
            </div>
            <div class="d-flex gap-2 z-1">
                <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-light text-primary fw-bold px-4 py-2.5 rounded-3 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Create Trip Ticket
                </a>
                <a asp-controller="User" asp-action="ShuttleViewer" class="btn btn-outline-light fw-bold px-4 py-2.5 rounded-3">
                    <i class="bi bi-bus-front me-1"></i> View Shuttles
                </a>
            </div>
        </div>
        <!-- Decorative background icon -->
        <div class="position-absolute end-0 bottom-0 opacity-10 me-n4 mb-n4 d-none d-md-block" style="pointer-events: none;">
            <i class="bi bi-car-front-fill" style="font-size: 14rem;"></i>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3.5 d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-ticket-perforated-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Total Submitted</div>
                        <div class="fs-3 fw-bold text-dark">14</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3.5 d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Pending Approval</div>
                        <div class="fs-3 fw-bold text-dark">2</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3.5 d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-calendar-check-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Approved Trips</div>
                        <div class="fs-3 fw-bold text-dark">3</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3.5 d-flex align-items-center gap-3">
                    <div class="bg-secondary bg-opacity-10 text-secondary p-3 rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-check-circle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Completed</div>
                        <div class="fs-3 fw-bold text-dark">9</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Split: Recent Tickets (8 cols) & Next Departure Focus (4 cols) -->
    <div class="row g-4">

        <!-- Left Column: Recent Ticket Requests Table -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold text-primary mb-0">
                        <i class="bi bi-clock-history me-2"></i>My Recent Requests
                    </h5>
                    <a asp-controller="User" asp-action="TripSchedule" class="btn btn-sm btn-light border small text-primary fw-semibold">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small text-uppercase fw-semibold">
                                <tr>
                                    <th scope="col" class="ps-4">Ticket #</th>
                                    <th scope="col">Trip Date</th>
                                    <th scope="col">Route</th>
                                    <th scope="col">Status</th>
                                    <th scope="col" class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#TK-2026-0891</td>
                                    <td>
                                        <div class="fw-semibold text-dark">Aug 03, 2026</div>
                                        <div class="small text-muted">08:30 AM</div>
                                    </td>
                                    <td>
                                        <div class="small fw-medium"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Building A</div>
                                        <div class="small text-muted"><i class="bi bi-flag-fill text-success me-1"></i> Plant 2 Terminal</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success px-2.5 py-1.5 rounded-pill fw-semibold">
                                            Approved
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#TK-2026-0893</td>
                                    <td>
                                        <div class="fw-semibold text-dark">Aug 04, 2026</div>
                                        <div class="small text-muted">01:30 PM</div>
                                    </td>
                                    <td>
                                        <div class="small fw-medium"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Logistics Hub</div>
                                        <div class="small text-muted"><i class="bi bi-flag-fill text-success me-1"></i> Main HQ</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-2.5 py-1.5 rounded-pill fw-semibold">
                                            Pending
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4 fw-bold text-primary">#TK-2026-0880</td>
                                    <td>
                                        <div class="fw-semibold text-dark">Jul 28, 2026</div>
                                        <div class="small text-muted">09:00 AM</div>
                                    </td>
                                    <td>
                                        <div class="small fw-medium"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Main HQ</div>
                                        <div class="small text-muted"><i class="bi bi-flag-fill text-success me-1"></i> Airport Hub</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-2.5 py-1.5 rounded-pill fw-semibold">
                                            Completed
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Next Departure Focus & Quick Actions -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">

            <!-- Next Departure Widget -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Next Departure
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="bg-light p-3 rounded-3 border mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary px-2.5 py-1">Today</span>
                            <span class="fw-bold text-primary">08:30 AM</span>
                        </div>
                        <div class="fw-bold text-dark fs-6 mb-1">Toyota Commuter #04</div>
                        <div class="small text-muted"><i class="bi bi-person me-1"></i>Driver: R. Santos</div>
                    </div>

                    <div class="d-flex flex-column gap-2 small">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Pickup:</span>
                            <span class="fw-semibold text-dark">Building A - Main Gate</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Drop-off:</span>
                            <span class="fw-semibold text-dark">Plant 2 Terminal</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Passengers:</span>
                            <span class="fw-semibold text-dark">4 Persons</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action Shortcuts -->
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-3">Quick Actions</h6>
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-light border text-start d-flex align-items-center p-2.5 rounded-3">
                            <i class="bi bi-plus-circle-fill text-primary fs-5 me-3"></i>
                            <div>
                                <div class="fw-semibold text-dark small">New Ticket Request</div>
                                <div class="text-muted small">Submit a trip ticket for approval</div>
                            </div>
                        </a>

                        <a asp-controller="User" asp-action="ShuttleViewer" class="btn btn-light border text-start d-flex align-items-center p-2.5 rounded-3">
                            <i class="bi bi-search text-success fs-5 me-3"></i>
                            <div>
                                <div class="fw-semibold text-dark small">Check Available Shuttles</div>
                                <div class="text-muted small">Explore routes and timings</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>