@{
    ViewData["Title"] = "Requestor Dashboard";
}

<div class="d-flex flex-column gap-4 mb-4">

    <!-- Welcome Header Banner -->
    <div class="card portal-welcome overflow-hidden">
        <div class="card-body p-4 p-lg-5 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-2 px-2 py-1 fw-semibold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.7rem;">
                    <i class="bi bi-speedometer2 me-1"></i> Requestor Overview
                </span>
                <h1 class="h3 fw-bold text-dark mb-1">Welcome back, @(User.Identity?.Name ?? "User")!</h1>
                <p class="mb-0 text-muted small">Manage your shuttle tickets, track approval statuses, and view upcoming trips.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="User" asp-action="ShuttleViewer" class="btn btn-light border fw-medium px-4 py-2">
                    <i class="bi bi-bus-front me-2"></i> View Shuttles
                </a>
                <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-primary fw-medium px-4 py-2 shadow-sm">
                    <i class="bi bi-plus-lg me-2"></i> Create Trip Ticket
                </a>
            </div>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center text-primary" style="width: 48px; height: 48px;">
                    <i class="bi bi-ticket-perforated fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Total Submitted</div>
                    <div class="fs-4 fw-bold text-dark">14</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 d-flex align-items-center justify-content-center text-warning" style="width: 48px; height: 48px;">
                    <i class="bi bi-hourglass-split fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Pending Approval</div>
                    <div class="fs-4 fw-bold text-dark">2</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center text-success" style="width: 48px; height: 48px;">
                    <i class="bi bi-calendar-check fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Approved Trips</div>
                    <div class="fs-4 fw-bold text-dark">3</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card p-3 d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center text-secondary" style="width: 48px; height: 48px;">
                    <i class="bi bi-check-circle fs-5"></i>
                </div>
                <div>
                    <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.7rem; letter-spacing: 0.5px;">Completed</div>
                    <div class="fs-4 fw-bold text-dark">9</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Split: Recent Tickets (8 cols) & Next Departure Focus (4 cols) -->
    <div class="row g-4">

        <!-- Left Column: Recent Ticket Requests Table -->
        <div class="col-12 col-lg-8">
            <div class="card p-0 overflow-hidden h-100">
                <div class="card-header bg-transparent py-3 border-bottom px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-semibold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-clock-history text-primary me-2"></i>My Recent Requests
                    </h6>
                    <a asp-controller="User" asp-action="TripSchedule" class="btn btn-sm btn-link text-decoration-none px-0 text-primary fw-medium small">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 w-100">
                            <thead class="bg-light text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                <tr>
                                    <th scope="col" class="px-4 py-3 border-bottom-0">Ticket #</th>
                                    <th scope="col" class="py-3 border-bottom-0">Trip Date</th>
                                    <th scope="col" class="py-3 border-bottom-0">Route</th>
                                    <th scope="col" class="py-3 border-bottom-0">Status</th>
                                    <th scope="col" class="text-end pe-4 py-3 border-bottom-0">Action</th>
                                </tr>
                            </thead>
                            <tbody class="text-dark small border-top">
                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 px-2 py-1 tracking-wider">
                                            #TK-2026-0891
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">Aug 03, 2026</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">08:30 AM</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><i class="bi bi-circle-fill text-primary" style="font-size: 0.4rem; vertical-align: middle;"></i> Building A</div>
                                        <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-circle text-muted" style="font-size: 0.4rem; vertical-align: middle;"></i> Plant 2 Terminal</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            Approved
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-muted" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 px-2 py-1 tracking-wider">
                                            #TK-2026-0893
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">Aug 04, 2026</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">01:30 PM</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><i class="bi bi-circle-fill text-primary" style="font-size: 0.4rem; vertical-align: middle;"></i> Logistics Hub</div>
                                        <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-circle text-muted" style="font-size: 0.4rem; vertical-align: middle;"></i> Main HQ</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">
                                            Pending Section
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-muted" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="ps-4 fw-bold text-primary">
                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 px-2 py-1 tracking-wider">
                                            #TK-2026-0880
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">Jul 28, 2026</div>
                                        <div class="text-muted" style="font-size: 0.75rem;">09:00 AM</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><i class="bi bi-circle-fill text-primary" style="font-size: 0.4rem; vertical-align: middle;"></i> Main HQ</div>
                                        <div class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-circle text-muted" style="font-size: 0.4rem; vertical-align: middle;"></i> Airport Hub</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                            Completed
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-light border text-muted" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Next Departure Focus & Quick Actions -->
        <div class="col-12 col-lg-4 d-flex flex-column gap-4">

            <!-- Next Departure Widget -->
            <div class="card h-100">
                <div class="card-header bg-transparent py-3 border-bottom px-4">
                    <h6 class="fw-semibold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-bell-fill text-warning me-2"></i>Next Departure
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                        <span class="badge bg-primary px-2 py-1 text-uppercase tracking-wider">Today</span>
                        <span class="fw-bold text-primary fs-5" style="font-variant-numeric: tabular-nums;">08:30 AM</span>
                    </div>

                    <div class="mb-4">
                        <div class="fw-bold text-dark fs-6 mb-1">Toyota Commuter #04</div>
                        <div class="small text-muted d-flex align-items-center">
                            <i class="bi bi-person-badge me-2"></i>Driver: R. Santos
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3 small">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt text-primary mt-1"></i>
                            <div>
                                <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Pickup Location</div>
                                <div class="fw-medium text-dark">Building A - Main Gate</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-flag text-success mt-1"></i>
                            <div>
                                <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Drop-off Location</div>
                                <div class="fw-medium text-dark">Plant 2 Terminal</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-people text-secondary mt-1"></i>
                            <div>
                                <div class="text-muted" style="font-size: 0.7rem; text-transform: uppercase;">Passengers</div>
                                <div class="fw-medium text-dark">4 Persons</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Action Shortcuts -->
            <div class="card">
                <div class="card-header bg-transparent py-3 border-bottom px-4">
                    <h6 class="fw-semibold text-dark mb-0">Quick Actions</h6>
                </div>
                <div class="card-body p-3">
                    <div class="d-flex flex-column gap-2">
                        <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-light border text-start d-flex align-items-center p-3 transition-all">
                            <div class="bg-white rounded p-2 border me-3 shadow-sm text-primary">
                                <i class="bi bi-plus-lg"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark small mb-1">New Ticket Request</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Submit a trip ticket for approval</div>
                            </div>
                        </a>

                        <a asp-controller="User" asp-action="ShuttleViewer" class="btn btn-light border text-start d-flex align-items-center p-3 transition-all">
                            <div class="bg-white rounded p-2 border me-3 shadow-sm text-success">
                                <i class="bi bi-search"></i>
                            </div>
                            <div>
                                <div class="fw-semibold text-dark small mb-1">Check Shuttles</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Explore routes and live timings</div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
