@{
    ViewData["Title"] = "Today's Shuttle Dispatch Queue";
}

<!-- Custom Light Theme Styles -->
<style>

</style>

<div class="container-fluid p-4">
    <!-- Header with Live Clock & Controls -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-bus-front-fill me-2 text-primary"></i> Shuttle Dispatch Board
            </h2>
            <p class="text-muted mb-0">Live Shuttle Departures & Schedules for Today</p>
        </div>
        <div class="text-end">
            <h3 id="liveClock" class="time-display text-primary mb-0">00:00:00 AM</h3>
            <span id="currentDate" class="text-muted fw-semibold">Loading date...</span>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="queue-card p-3 d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary fs-3">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 text-uppercase fw-semibold">Total Scheduled</span>
                    <h3 id="statTotal" class="fw-bold mb-0 text-dark">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="queue-card p-3 d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success fs-3">
                    <i class="bi bi-play-circle-fill"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 text-uppercase fw-semibold">On the Road</span>
                    <h3 id="statActive" class="fw-bold mb-0 text-dark">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="queue-card p-3 d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3 text-warning fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 text-uppercase fw-semibold">Upcoming Trips</span>
                    <h3 id="statPending" class="fw-bold mb-0 text-dark">0</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="queue-card p-3 d-flex align-items-center">
                <div class="rounded-circle bg-secondary bg-opacity-10 p-3 me-3 text-secondary fs-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <span class="text-muted fs-7 text-uppercase fw-semibold">Completed</span>
                    <h3 id="statCompleted" class="fw-bold mb-0 text-dark">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="row mb-3 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="queueSearch" class="form-control border-start-0 shadow-none ps-0" placeholder="Search vehicle, driver, destination...">
            </div>
        </div>
        <div class="col-md-8 text-end">
            <button id="btnRefresh" class="btn btn-outline-primary btn-sm px-3 me-2">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh Board
            </button>
            <span class="text-muted fs-7 ms-2">Auto-refreshes every 30s</span>
        </div>
    </div>

    <!-- Main Light Queuing Table -->
    <div class="queue-card p-3">
        <div class="table-responsive">
            <table id="ShuttleQueueTable" class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted fs-7 text-uppercase">
                    <tr>
                        <th>Time</th>
                        <th>Ticket No.</th>
                        <th>Vehicle & Plate</th>
                        <th>Driver</th>
                        <th>Destination</th>
                        <th>Passengers</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody id="queueTableBody" class="fs-6">
                    <!-- Dynamic Rows Render Here -->
                </tbody>
            </table>
        </div>
    </div>
</div>