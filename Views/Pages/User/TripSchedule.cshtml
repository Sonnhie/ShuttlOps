@using ShuttlOps.DTOs
@model IEnumerable<ShuttlOps.Models.TripTicket>
@{
    ViewData["Title"] = "Trip Schedule";
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-sm-center flex-column flex-sm-row gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Trip Schedule</h1>
            <p class="text-muted mb-0">Monitor scheduled shuttle trips, passenger assignments, and dispatch status.</p>
        </div>
        <div>
            <a asp-controller="User" asp-action="CreateTicketPage" class="btn btn-primary px-4 shadow-sm">
                <i class="bi bi-plus-lg me-2"></i> New Trip Request
            </a>
        </div>
    </div>
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="statusFilter" class="col-form-label fw-bold text-muted me-2">
                        <i class="bi bi-funnel me-1"></i> Filter Status:
                    </label>
                </div>
                <div class="col-auto">
                    <select id="statusFilter" class="form-select form-select-sm shadow-none" style="min-width: 160px;">
                        <option value="">All Statuses</option>
                        <option value="Pending Section Head">Pending Section Head</option>
                        <option value="Pending GA Approve">Pending GA Approve</option>
                        <option value="Approved">Approved</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-list-task me-2"></i>Trip Directory</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml" 
                        model='new ReusableTableDTO {
                            TableHeaders = new List<string> { "Ticket Number", "Status", "Date Of Trip" , "Departure Time", "Pickup Location", "Dropoff Location", "Purpose", "Action"},
                            TableId  = "TripScheduleTable"
                        }'/>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/TripSchedule.js"></script>
}