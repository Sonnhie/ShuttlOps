@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column gap-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-sm-center flex-column flex-sm-row gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">User List</h1>
            <p class="text-muted mb-0">Manage user profile details, update credentials, and configure account settings.</p>
        </div>
        <div>
           <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#AddUserModal">
                <i class="bi bi-person-add me-1"></i> Add User
           </button>
        </div>
    </div>
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="departmentFilter" class="col-form-label fw-bold text-muted me-2">
                        <i class="bi bi-funnel me-1"></i> Filter Department:
                    </label>
                </div>
                <div class="col-auto">
                    <select id="departmentFilter" class="form-select form-select-sm shadow-none" style="min-width: 160px;">
                    </select>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-list-task me-2"></i>User Directory</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml" 
                        model='new ReusableTableDTO {
                            TableHeaders = new List<string> { "Employee ID", "Employee Name", "Email Address", "Department", "Role", "Action"},
                            TableId  = "UserManagementTable"
                        }'/>
                </div>
            </div>
        </div>
    </div>

     <partial 
         name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
         model= 'new ReusableModalDTO {
                   ModalId = "AddUserModal",
                   ModalTitle = "Create User Account",
                   ModalIcon = "bi-person-plus-fill",
                   FormId = "AddUserForm",
                   SubmitButtonText = "Create",
                   BodyPartialName = "~/Views/Shared/Partials/Forms/_CreateUserFormPartial.cshtml"
         }'/>
</div>

 
@section Scripts {
    <script src="~/js/User.js "></script>
}