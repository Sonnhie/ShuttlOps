@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "User Management";
}

<div class="d-flex flex-column gap-4">
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3">
        <div>
            <div class="eyebrow mb-1">Administration</div>
            <h1 class="fw-bold mb-1">User management</h1>
            <p class="mb-0">Manage user identities, organizational assignment, and role access.</p>
        </div>
        <button type="button" class="btn btn-primary px-3" data-bs-toggle="modal" data-bs-target="#AddUserModal">
            <i class="bi bi-person-plus me-2"></i>Add user
        </button>
    </div>

    <div class="filter-bar d-flex align-items-center gap-3 flex-wrap">
        <span class="section-icon"><i class="bi bi-funnel"></i></span>
        <label for="departmentFilter" class="filter-label mb-0">Department</label>
        <select id="departmentFilter" class="form-select form-select-sm shadow-none"></select>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="section-icon"><i class="bi bi-people"></i></span>
                <div><h2 class="card-title fw-bold mb-0">User directory</h2><span class="text-muted small">All registered portal users</span></div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive m-3">
                <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                         model='new ReusableTableDTO {
                             TableHeaders = new List<string> { "Employee ID", "Employee Name", "Email Address", "Department", "Role", "Action"},
                             TableId = "UserManagementTable"
                         }' />
            </div>
        </div>
    </div>

    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
             model='new ReusableModalDTO {
                 ModalId = "AddUserModal", ModalTitle = "Create User Account", ModalIcon = "bi-person-plus-fill",
                 FormId = "AddUserForm", SubmitButtonText = "Create user",
                 BodyPartialName = "~/Views/Shared/Partials/Forms/_CreateUserFormPartial.cshtml"
             }' />
</div>

@section Scripts {
    <script src="~/js/User.js"></script>
}
