@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "System Modules";
}

<div class="d-flex flex-column gap-4">
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3">
        <div>
            <div class="eyebrow mb-1">System configuration</div>
            <h1 class="fw-bold mb-1">System modules</h1>
            <p class="mb-0">Manage the features available in the portal and their operational status.</p>
        </div>
        <button type="button" class="btn btn-primary px-3" data-bs-toggle="modal" data-bs-target="#moduleModal"><i class="bi bi-plus-lg me-2"></i>Add module</button>
    </div>

    <div class="filter-bar d-flex align-items-center gap-3 flex-wrap">
        <span class="section-icon"><i class="bi bi-funnel"></i></span>
        <label for="moduleFilter" class="filter-label mb-0">Module</label>
        <select id="moduleFilter" class="form-select form-select-sm shadow-none"></select>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span class="section-icon"><i class="bi bi-grid-1x2"></i></span>
            <div><h2 class="card-title fw-bold mb-0">Module directory</h2><span class="text-muted small">Registered portal features and availability</span></div>
        </div>
        <div class="card-body p-0"><div class="table-responsive m-3">
            <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                     model='new ReusableTableDTO { TableHeaders = new List<string> { "Module ID", "Module Name", "Description", "Status", "Status toggle", "" }, TableId = "moduleTable" }' />
        </div></div>
    </div>

    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
             model='new ReusableModalDTO { ModalId = "moduleModal", ModalTitle = "Create New Module", ModalIcon = "bi-boxes", FormId = "creatModuleForm", SubmitButtonText = "Create module", BodyPartialName = "~/Views/Shared/Partials/Forms/_ModuleFormPartial.cshtml" }' />
</div>

@section Scripts { <script src="~/js/Module.js"></script> }
