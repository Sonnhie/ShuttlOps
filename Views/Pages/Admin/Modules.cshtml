@using ShuttlOps.DTOs
﻿@{
    ViewData["Title"] = "Modules";
}


<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">System Modules</h1>
            <p class="text-muted mb-0">Manage system modules, activation of new features, and registration of new features.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#moduleModal">
                <i class="bi bi-plus"></i> Add Module
            </button>
        </div>
    </div>
     
    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="departmentFilter" class="col-form-label fw-bold text-muted me-2">
                        <i class="bi bi-funnel me-1"></i> Filter Module:
                    </label>
                </div>
                <div class="col-auto">
                    <select id="moduleFilter" class="form-select form-select-sm shadow-none" style="min-width: 160px;">
                    </select>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-list-task me-2"></i>Modules and Features Directory</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml" 
                            model= 'new ReusableTableDTO {
                                    TableHeaders = new List<string> { "Module ID", "Module Name" , "Description", "Status", "Status toggle", "" },
                                    TableId = "moduleTable"
                        }'/>
                </div>
            </div>

        </div>
    </div>


    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
            model= 'new ReusableModalDTO {
                   ModalId = "moduleModal",
                   ModalTitle = "Create New Module",
                   ModalIcon = "bi-boxes",
                   FormId = "creatModuleForm",
                   SubmitButtonText = "Create",
                   BodyPartialName = "~/Views/Shared/Partials/Forms/_ModuleFormPartial.cshtml"
        }'/>
</div>

@section Scripts {
    <script src="~/js/Module.js"></script>
}