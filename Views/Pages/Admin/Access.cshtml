@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "Access and Permission";
}

<div class="d-flex flex-column gap-4">
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3">
        <div>
            <div class="eyebrow mb-1">Governance</div>
            <h1 class="fw-bold mb-1">Access and permissions</h1>
            <p class="mb-0">Define the actions each role can perform across the ShuttlOps portal.</p>
        </div>
        <button type="button" class="btn btn-primary px-3" data-bs-toggle="modal" data-bs-target="#permissionModal"><i class="bi bi-shield-plus me-2"></i>Add access rule</button>
    </div>

    <div class="filter-bar d-flex align-items-center gap-3 flex-wrap">
        <span class="section-icon"><i class="bi bi-funnel"></i></span>
        <label for="role_select" class="filter-label mb-0">Role</label>
        <select id="role_select" class="form-select form-select-sm shadow-none"></select>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span class="section-icon"><i class="bi bi-shield-check"></i></span>
            <div><h2 class="card-title fw-bold mb-0">Permission directory</h2><span class="text-muted small">Role permissions by module and capability</span></div>
        </div>
        <div class="card-body p-0"><div class="table-responsive m-3">
            <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                     model='new ReusableTableDTO { TableHeaders = new List<string> { "Role", "Modules", "View", "Create", "Edit", "Delete", "Approve", "" }, TableId = "permissionTable" }' />
        </div></div>
    </div>

    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
             model='new ReusableModalDTO { ModalId = "permissionModal", ModalTitle = "Create Access Rule", ModalIcon = "bi-shield-plus", FormId = "permissionForm", SubmitButtonText = "Create rule", BodyPartialName = "~/Views/Shared/Partials/Forms/_CreatePermissionForm.cshtml" }' />
</div>

@section Scripts { <script src="~/js/Access.js"></script> }
