@using ShuttlOps.DTOs
﻿@{
    ViewData["Title"] = "Groups and Clusters";
}


<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5 class="mb-3">Department</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#AddDepartmentModal">
                <i class="bi bi-plus"></i> Add Department
            </button>
        </div>
    </div>

    <div class="card mb-3 border-0 shadow-sm">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-auto">
                    <label for="departmentFilter" class="col-form-label fw-bold text-muted me-2">
                        <i class="bi bi-funnel me-1"></i> Filter Department:
                    </label>
                </div>
                <div class="col-auto">
                    <select id="departmentFilter" class="form-select form-select-sm shadow-none" style="min-width: 160px;">
                    </select>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="card-title fw-bold text-primary mb-0"><i class="bi bi-list-task me-2"></i>Department Directory</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml" 
                            model= 'new ReusableTableDTO {
                                    TableHeaders = new List<string> { "Department ID", "Department Name" , "Manager Id", "Members Count", "Action" },
                                    TableId = "departmentTable"
                        }'/>
                </div>
            </div>

        </div>
    </div>


    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
            model= 'new ReusableModalDTO {
                   ModalId = "AddDepartmentModal",
                   ModalTitle = "Create Department",
                   ModalIcon = "bi-folder-fill",
                   FormId = "AddDepartmentForm",
                   SubmitButtonText = "Create",
                   BodyPartialName = "~/Views/Shared/Partials/Forms/_DepartmentFormPartial.cshtml"
        }'/>
</div>

@section Scripts {
    <script src="~/js/Group.js"></script>
}