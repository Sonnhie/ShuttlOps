@using ShuttlOps.DTOs
@{
    ViewData["Title"] = "Groups and Clusters";
}

<div class="d-flex flex-column gap-4">
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3">
        <div>
            <div class="eyebrow mb-1">Administration</div>
            <h1 class="fw-bold mb-1">Groups and clusters</h1>
            <p class="mb-0">Maintain department structures used for trip ownership and operational reporting.</p>
        </div>
        <button type="button" class="btn btn-primary px-3" data-bs-toggle="modal" data-bs-target="#AddDepartmentModal"><i class="bi bi-plus-lg me-2"></i>Add department</button>
    </div>

    <div class="filter-bar d-flex align-items-center gap-3 flex-wrap">
        <span class="section-icon"><i class="bi bi-funnel"></i></span>
        <label for="departmentFilter" class="filter-label mb-0">Department</label>
        <select id="departmentFilter" class="form-select form-select-sm shadow-none"></select>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span class="section-icon"><i class="bi bi-diagram-3"></i></span>
            <div><h2 class="card-title fw-bold mb-0">Department directory</h2><span class="text-muted small">Organizational groups and accountable managers</span></div>
        </div>
        <div class="card-body p-0"><div class="table-responsive m-3">
            <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                     model='new ReusableTableDTO { TableHeaders = new List<string> { "Department ID", "Department Name", "Manager Id", "Members Count", "Action" }, TableId = "departmentTable" }' />
        </div></div>
    </div>

    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
             model='new ReusableModalDTO { ModalId = "AddDepartmentModal", ModalTitle = "Create Department", ModalIcon = "bi-folder-fill", FormId = "AddDepartmentForm", SubmitButtonText = "Create department", BodyPartialName = "~/Views/Shared/Partials/Forms/_DepartmentFormPartial.cshtml" }' />

    <partial name="~/Views/Shared/Partials/Modal/_GenericModal.cshtml"
             model='new ReusableModalDTO { ModalId = "AssignManagerModal", ModalTitle = "Assign Manager", ModalIcon = "bi-person-check-fill", FormId = "AssignManagerForm", SubmitButtonText = "Assign Manager", BodyPartialName = "~/Views/Shared/Partials/Forms/_AssignFormPartial.cshtml" }' />
</div>

@section Scripts { <script src="~/js/Group.js"></script> }
