@model IEnumerable<ShuttlOps.Models.TripTicket>
@{
    ViewData["Title"] = "Dispatch Dashboard";
    var tickets = Model ?? Enumerable.Empty<ShuttlOps.Models.TripTicket>();
    var pendingList = tickets.Where(t => t.ApprovalStatus == "Pending");
}

<div class="d-flex flex-column gap-4">
    <div class="portal-page-header">
        <div class="eyebrow mb-1">Operations control</div>
        <h1 class="fw-bold mb-1">Dispatch dashboard</h1>
        <p class="mb-0">Review approvals and keep the transportation workflow moving.</p>
    </div>

    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card p-3 d-flex flex-row align-items-center gap-3" style="--metric-color: #e69a16;">
                <span class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-hourglass-split fs-5"></i></span>
                <div><div class="metric-label">Pending approvals</div><div class="metric-value mt-1">@pendingList.Count()</div></div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card metric-card p-3 d-flex flex-row align-items-center gap-3" style="--metric-color: #1769e0;">
                <span class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-ticket-perforated fs-5"></i></span>
                <div><div class="metric-label">Total requests</div><div class="metric-value mt-1">@tickets.Count()</div></div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="section-icon"><i class="bi bi-clipboard-check"></i></span>
                <div><h2 class="card-title fw-bold mb-0">Pending approval queue</h2><span class="text-muted small">Requests awaiting an operational decision</span></div>
            </div>
            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2">@pendingList.Count() awaiting review</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 w-100">
                    <thead><tr><th>Ticket ref</th><th>Requestor</th><th>Trip date & time</th><th>Route</th><th class="text-end">Action</th></tr></thead>
                    <tbody>
                    @if (!pendingList.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted"><i class="bi bi-check-circle-fill text-success fs-4 d-block mb-2"></i><span class="fw-semibold">No pending approvals</span><br /><small>Your approval queue is clear.</small></td></tr>
                    }
                    else
                    {
                        @foreach (var ticket in pendingList)
                        {
                            <tr>
                                <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">@ticket.TicketNumber</span></td>
                                <td><div class="fw-semibold">@ticket.RequestorName</div><small class="text-muted">ID: @ticket.RequestorId</small></td>
                                <td><div class="fw-semibold">@ticket.DateOfTrip.ToString("MMM dd, yyyy")</div><small class="text-muted">@ticket.EstDepartureTime.ToString("hh:mm tt")</small></td>
                                <td><div class="fw-medium">@ticket.PickupLocation <i class="bi bi-arrow-right text-muted mx-1"></i> @ticket.DropoffLocation</div><small class="text-muted d-inline-block text-truncate" style="max-width: 250px;">@ticket.Purpose</small></td>
                                <td class="text-end"><form asp-controller="Admin" asp-action="ApproveTicket" method="post" class="d-inline"><input type="hidden" name="ticketId" value="@ticket.TicketId" /><button type="submit" class="btn btn-sm btn-success px-3"><i class="bi bi-check2 me-1"></i>Approve</button></form></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
