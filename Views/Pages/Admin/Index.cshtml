@model IEnumerable<ShuttlOps.Models.TripTicket>
@{
    ViewData["Title"] = "Admin Dispatch Dashboard";

    // Fallback to empty enumerable if Model is null
    var tickets = Model ?? Enumerable.Empty<ShuttlOps.Models.TripTicket>();
    var pendingList = tickets.Where(t => t.ApprovalStatus == "Pending");
}

<div class="d-flex flex-column gap-4">
    <!-- Metric Cards -->
    <div class="row g-3">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-3.5 d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3">
                        <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small fw-semibold">Pending Approvals</div>
                        <div class="fs-3 fw-bold text-dark">@pendingList.Count()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Table Queue -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-clock-history text-warning me-2"></i>Pending Approval Queue</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase fw-semibold">
                        <tr>
                            <th class="ps-4">Ticket Ref</th>
                            <th>Requestor</th>
                            <th>Trip Date & Time</th>
                            <th>Route</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in pendingList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">@ticket.TicketNumber</td>
                                <td>
                                    <div class="fw-semibold text-dark">@ticket.RequestorName</div>
                                    <div class="small text-muted">ID: @ticket.RequestorId</div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@ticket.DateOfTrip.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-muted">@ticket.EstDepartureTime.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <div class="small fw-medium">@ticket.PickupLocation → @ticket.DropoffLocation</div>
                                    <div class="small text-muted">Purpose: @ticket.Purpose</div>
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-controller="Admin" asp-action="ApproveTicket" method="post" class="d-inline">
                                        <input type="hidden" name="ticketId" value="@ticket.TicketId" />
                                        <button type="submit" class="btn btn-sm btn-success px-3 fw-semibold">Approve</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>