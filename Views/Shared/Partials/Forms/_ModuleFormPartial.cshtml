<div class="row g-3 mb-3">
    <div class="col-sm-12">
        <label class="form-label">Module Name</label>
        <input type="text" id="module_name" name="name" value="" class="form-control" placeholder="e.g. Vehicle Dispatch" />
    </div>
</div>

<div class="bg-light p-3 rounded-3 border mt-3">
    <label class="form-label">Module Description</label>
    <textarea class="form-control" id="description" rows="3" placeholder="Describe what this module manages"></textarea>
</div>
