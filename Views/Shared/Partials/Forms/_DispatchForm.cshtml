<input type="hidden" id="driverId" name="DriverId" value="" />
<input type="hidden" id="vehicleId" name="VehicleId" value="" />
<input type="hidden" id="ticketId" name="TicketId" />
<div class="row g-3 mb-4">
    <div class="col-sm-12">
        <label class="form-label text-secondary small text-uppercase">
            Driver Name
        </label>
        <select class="form-select shadow-sm border-secondary-subtle" id="driverName" name="driverName" required>
            
        </select>
        <input type="hidden" id="driverSelect" name="DriverName" />
    </div>
    <div class="col-sm-12">
        <label class="form-label text-secondary small text-uppercase">
           Vehicle
        </label>
        <select class="form-select shadow-sm border-secondary-subtle" id="vehicleName" name="vehicleName" required>
        </select>
    </div>
</div>

<!--Read only-->
<div class="row g-3 mb-4">
    <div class="col-sm-12">
        <label class="form-label text-secondary small text-uppercase">
            Plate Number
        </label>
        <input class="form-control shadow-sm" id="plateNumber" readonly />
    </div>
    <div class="col-sm-12">
        <label class="form-label text-secondary small text-uppercase">
           Vehicle Capacity
        </label>
        <input class="form-control shadow-sm" id="capacity" readonly />
    </div>
    <div class="col-sm-12">
        <label class="form-label text-secondary small text-uppercase">
            Vehicle Status
        </label>
        <input class="form-control shadow-sm" id="Status" readonly />
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-12 form-floating">
        <input class="form-control" placeholder="Leave a remarks here" id="Remarks" style="height: 100px"/>
        <label class="form-label small" for="Remarks">GA Remarks</label>
    </div>
</div>
