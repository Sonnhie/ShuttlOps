<div class="row g-3 mb-3">
    <div class="col-sm-12">
        <label class="form-label">Employee Name</label>
        <input type="text" id="name_input" class="form-control" placeholder="Enter full name" />
    </div>
    <div class="col-sm-12">
        <label class="form-label">Email Address</label>
        <input type="email" id="email_input" class="form-control" placeholder="name@company.com" />
    </div>
</div>
<div class="row g-3 mb-3">
    <div class="col-sm-12">
        <label class="form-label">Employee ID</label>
        <input type="text" id="id_input" class="form-control" placeholder="Enter corporate ID" />
    </div>
</div>
<div class="row g-3">
    <div class="col-sm-6">
        <label class="form-label">Role</label>
        <select class="form-select" id="role_select" name="department" required></select>
    </div>
    <div class="col-sm-6">
        <label class="form-label">Department</label>
        <select class="form-select" id="department_select" name="department" required></select>
    </div>
</div>
