<div class="row g-3 mb-4">
    <div class="col-sm-12">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Employee Name</label>
        <input type="text" id="name_input" class="form-control shadow-sm" />
    </div>
    <div class="col-sm-12">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Email Address</label>
        <input type="email" id="email_input" class="form-control shadow-sm" />
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-12">
        <label class="form-label fw-semibold text-secondary small text-uppercase">User Id</label>
        <input type="text" id="id_input" class="form-control shadow-sm" />
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Role</label>
        <select class="form-select shadow-sm" id="role_select" name="department" required>
        </select>
    </div>
    <div class="col-sm-6">
        <label class="form-label fw-semibold text-secondary small text-uppercase">Department</label>
        <select class="form-select shadow-sm" id="department_select" name="department" required>
        </select>
    </div>
</div>