@using ShuttlOps.DTOs
<section id="ga-workspace" class="ga-workspace" aria-label="General Affairs operations workspace">
    <div class="portal-page-header d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3 mb-0">
        <div>
            <div class="eyebrow mb-1">General Affairs</div>
            <h1 class="fw-bold mb-1">Fleet operations</h1>
            <p class="mb-0">Manage vehicles, drivers, and dispatch readiness. Use Schedule Calendar for the shared monthly view.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="User" asp-action="ScheduleCalendar" class="btn btn-light">
                <i class="bi bi-calendar3 me-2"></i>Schedule calendar
            </a>
            <a href="#fleet-vehicles" class="btn btn-primary">
                <i class="bi bi-plus-lg me-2"></i>Manage fleet
            </a>
        </div>
    </div>

    <div id="ga-overview" class="workspace-panel mt-4" data-workspace-panel>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#1769e0">
                    <span class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-bus-front fs-5"></i></span>
                    <div><div class="metric-label">Fleet vehicles</div><div class="metric-value mt-1" id="gaVehicleCount">—</div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#198754">
                    <span class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-person-vcard fs-5"></i></span>
                    <div><div class="metric-label">Registered drivers</div><div class="metric-value mt-1" id="gaDriverCount">—</div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#e69a16">
                    <span class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-hourglass-split fs-5"></i></span>
                    <div><div class="metric-label">Awaiting GA</div><div class="metric-value mt-1" id="gaPendingCount">—</div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card metric-card p-3 d-flex align-items-center gap-3" style="--metric-color:#19a7ce">
                    <span class="metric-icon bg-info bg-opacity-10 text-info"><i class="bi bi-calendar-check fs-5"></i></span>
                    <div><div class="metric-label">Trips this month</div><div class="metric-value mt-1" id="gaMonthTripCount">—</div></div>
                </div>
            </div>
        </div>
        <div class="row g-4 mt-1">
            <div class="col-12 col-xl-8">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon"><i class="bi bi-clock-history"></i></span>
                            <div>
                                <h2 class="card-title fw-bold mb-0">Upcoming dispatches</h2>
                                <span class="text-muted small">Next approved trips from the schedule</span>
                            </div>
                        </div>
                        <a asp-controller="User" asp-action="ScheduleCalendar" class="btn btn-sm btn-light">Open calendar</a>
                    </div>
                    <div class="card-body p-0">
                        <div id="gaUpcomingTrips" class="ga-upcoming-list">
                            <div class="text-muted text-center py-5"><span class="spinner-border spinner-border-sm me-2"></span>Loading schedule…</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-xl-4">
                <div class="card h-100">
                    <div class="card-header">
                        <div class="d-flex align-items-center gap-2">
                            <span class="section-icon"><i class="bi bi-lightning-charge"></i></span>
                            <div>
                                <h2 class="card-title fw-bold mb-0">Quick actions</h2>
                                <span class="text-muted small">Fleet and schedule shortcuts</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-body d-grid gap-2">
                        <a href="#fleet-vehicles" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-bus-front"></i></span>
                            <span><strong>Vehicle directory</strong><small>Review fleet capacity and plates</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                        <a href="#fleet-drivers" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-person-vcard"></i></span>
                            <span><strong>Driver directory</strong><small>Review driver credentials</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                        <a asp-controller="User" asp-action="ScheduleCalendar" class="quick-workspace-action">
                            <span class="section-icon"><i class="bi bi-calendar-week"></i></span>
                            <span><strong>Schedule calendar</strong><small>Shared monthly dispatch calendar</small></span>
                            <i class="bi bi-arrow-right ms-auto"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="fleet-vehicles" class="workspace-panel d-none mt-4" data-workspace-panel>
        <div class="d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3 mb-3">
            <div>
                <div class="eyebrow mb-1">Fleet management</div>
                <h2 class="h4 fw-bold mb-1">Vehicle directory</h2>
                <p class="text-muted mb-0">Registered vehicles available for shuttle allocation.</p>
            </div>
            <button class="btn btn-primary" type="button" data-mock-form="vehicle-add">
                <i class="bi bi-plus-lg me-2"></i>Add vehicle
            </button>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                             model='new ReusableTableDTO {
                                 TableHeaders = new List<string> { "Vehicle Id", "Model", "Plate Number", "Capacity", "Status", "Action"},
                                 TableId = "VehicleTable"
                             }' />
                </div>
            </div>
        </div>
    </div>

    <div id="fleet-drivers" class="workspace-panel d-none mt-4" data-workspace-panel>
        <div class="d-flex justify-content-between align-items-sm-end flex-column flex-sm-row gap-3 mb-3">
            <div>
                <div class="eyebrow mb-1">Fleet management</div>
                <h2 class="h4 fw-bold mb-1">Driver directory</h2>
                <p class="text-muted mb-0">Registered drivers available for dispatch assignment.</p>
            </div>
            <button class="btn btn-primary" type="button" data-mock-form="driver-add">
                <i class="bi bi-plus-lg me-2"></i>Add driver
            </button>
        </div>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive m-3">
                    <partial name="~/Views/Shared/Partials/Table/_GenericTablePartial.cshtml"
                             model='new ReusableTableDTO {
                                 TableHeaders = new List<string> { "Driver ID", "Driver", "Contact Number", "License Number", "Status", "Action" },
                                 TableId = "DriverTable"
                             }' />
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="fleetMockModal" tabindex="-1" aria-labelledby="fleetMockModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="fleetMockModalTitle">Fleet record</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="fleetMockForm">
                <div class="modal-body">
                    <div id="fleetMockFields" class="row g-3"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="fleetViewModal" tabindex="-1" aria-labelledby="fleetViewModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="fleetViewModalTitle">Record details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="fleetViewContent"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

