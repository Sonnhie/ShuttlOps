@model ShuttlOps.DTOs.ReusableTableDTO
@{
}



<table id="@Model.TableId" class="table table-hover align-middle mb-0 w-100">
    <thead class="bg-light text-muted small text-uppercase fw-semibold">
        <tr>
            @foreach (var header in Model.TableHeaders)
            {
                <th scope="col">@header</th>
            }
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>