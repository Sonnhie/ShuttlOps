@model ShuttlOps.DTOs.ReusableModalDTO
@{
}


<div class="modal fade" id="@Model.ModalId" tabindex="-1" aria-labelledby="@($"{Model.ModalId}Label")" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="@($"{Model.ModalId}Label")">
                    <span class="modal-title-icon"><i class="bi @Model.ModalIcon"></i></span>
                    @Model.ModalTitle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @if (!string.IsNullOrEmpty(Model.FormId))
            {
                <form id="@Model.FormId" method="post">
                    <div class="modal-body p-4">
                        <partial name="@Model.BodyPartialName" />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">@Model.SubmitButtonText</button>
                    </div>
                </form>
            }
            else
            {
                <div class="modal-body p-4">
                    <partial name="@Model.BodyPartialName" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                </div>
            }

        </div>
    </div>
</div>
