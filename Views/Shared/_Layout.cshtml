@{
    // Extract all roles from the current user's claims
    var roles = User.Claims
        .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
        .Select(c => c.Value);

    var userRolesString = string.Join(",", roles);
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShuttlOps</title>

    <!-- Fonts: Adding Inter for a cleaner, modern tech look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Core & Vendor Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/sweetalert/sweetalert2.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/flatpickr/flatpickr.min.css" asp-append-version="true">

    <!-- Custom Application Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body" data-user-roles="@userRolesString">
    @Html.AntiForgeryToken()
    <div id="wrapper">

        <!-- Sidebar Navigation -->
        <aside id="sidebar-wrapper">
            <div class="px-4 py-3 border-bottom d-flex align-items-center" style="height: 64px;">
                <a class="text-decoration-none d-flex align-items-center text-primary fs-5 fw-bold" href="~/">
                    <i class="bi bi-car-front-fill fs-5 text-primary me-2"></i>
                    <span>ShuttlOps</span>
                </a>
            </div>
            @await Component.InvokeAsync("Sidebar")
        </aside>

        <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label="Close navigation"></button>

        <!-- Main Content Area -->
        <div id="content-wrapper">

            <!-- Top Navbar -->
            <header class="navbar navbar-expand-lg sticky-top px-4" style="height: 64px;">
                <div class="container-fluid p-0 d-flex align-items-center">

                    <button class="btn btn-link text-dark p-1 me-3 text-decoration-none" id="menu-toggle" type="button" aria-label="Toggle navigation">
                        <i class="bi bi-list fs-4"></i>
                    </button>

                    <!-- Dynamic Page Title -->
                    <div class="d-flex align-items-center me-2 text-truncate">
                        <h1 class="fw-semibold text-dark fs-5 mb-0 text-truncate">
                            @ViewData["Title"]
                        </h1>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="ms-auto d-flex align-items-center">
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 border-0 bg-transparent px-2 py-1" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px;">
                                    @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </span>
                                <span class="fw-medium text-dark small d-none d-sm-inline">
                                    @(User.Identity?.Name ?? "User")
                                </span>
                                <i class="bi bi-chevron-down text-muted small"></i>
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end border shadow-sm mt-2 py-2 rounded-3">
                                <li>
                                    <a class="dropdown-item small py-2 d-flex align-items-center" href="#">
                                        <i class="bi bi-person-circle me-2 text-muted"></i> Profile Settings
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item small text-danger py-2 d-flex align-items-center" id="logout" href="#">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Body Content -->
            <main role="main" id="main-content" class="container-fluid px-4 py-4 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/flatpickr/flatpickr.min.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert/sweetalert2.min.js" asp-append-version="true"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/logout.js"></script>
    <script src="~/js/common.js"></script>
    
    
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://unpkg.com/jszip@3.10.1/dist/jszip.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const toggleButton = document.getElementById("menu-toggle");
            const wrapper = document.getElementById("wrapper");
            const sidebarBackdrop = document.getElementById("sidebar-backdrop");

            if (toggleButton && wrapper) {
                toggleButton.addEventListener("click", function (e) {
                    e.preventDefault();
                    wrapper.classList.toggle("toggled");
                });
            }

            if (sidebarBackdrop && wrapper) {
                sidebarBackdrop.addEventListener("click", function () {
                    wrapper.classList.remove("toggled");
                });
            }

            // Close sidebar on mobile when clicking a link
            document.querySelectorAll("#sidebar-wrapper a").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (!link.hasAttribute("data-bs-toggle") && window.matchMedia("(max-width: 768px)").matches) {
                        wrapper.classList.remove("toggled");
                    }
                });
            });
        });
    </script>
</body>
</html>