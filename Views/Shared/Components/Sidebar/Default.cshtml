
@model HashSet<string>

<nav class="sidebar-nav px-3 mt-3 fw-medium" aria-label="Sidebar Navigation">
    @{
        bool showRequestorMngmt = Model.Contains("Request Management");

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var isUserArea = currentController == "User";
        var isAdminArea = currentController == "Admin";
        var isRequestManagementActive = isUserArea &&
        (currentAction == "CreateTicketPage" || currentAction == "TripSchedule" || currentAction == "ShuttleViewer");
        var isUserManagementActive = isAdminArea &&
        (currentAction == "Users" || currentAction == "Groups" || currentAction == "Modules" || currentAction == "Access");
    }

    @if (showRequestorMngmt)
    {
        <div class="nav-section-label text-uppercase text-muted px-3 mb-2 small fw-semibold tracking-wider">
            Main Menu
        </div>

        @if(Model.Contains("Admin Dashboard"))
        {
            <a asp-controller="Admin" asp-action="Index"
               class="nav-link-custom d-flex align-items-center px-3 py-2.5 rounded-3 mb-1 @(isAdminArea && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-house-door me-3 fs-5"></i>
                <span>Dashboard</span>
            </a>
        }

        @if (Model.Contains("Requestor Dashboard"))
        {
            <a asp-controller="User" asp-action="Index"
               class="nav-link-custom d-flex align-items-center px-3 py-2.5 rounded-3 mb-1 @(isUserArea && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-grid-1x2 me-3 fs-5"></i>
                <span>Dashboard</span>
            </a>
        }

        @if (Model.Contains("Request Management"))
        {
            <div class="nav-item-group mb-1">
                <a href="#requestSubmenu"
                   data-bs-toggle="collapse"
                   aria-expanded="@(isRequestManagementActive.ToString().ToLowerInvariant())"
                   class="nav-link-custom d-flex justify-content-between align-items-center px-3 py-2.5 rounded-3 @(isRequestManagementActive ? "" : "collapsed") @(isRequestManagementActive ? "active-parent" : "")">
                    <span class="d-flex align-items-center">
                        <i class="bi bi-send me-3 fs-5"></i>
                        <span>Request Management</span>
                    </span>
                    <i class="bi bi-chevron-right submenu-arrow small"></i>
                </a>

                <div class="collapse @(isRequestManagementActive ? "show" : "") mt-1 ps-3" id="requestSubmenu">
                    <div class="d-flex flex-column gap-1 border-start border-2 ps-2 my-1">
                        <a asp-controller="User" asp-action="CreateTicketPage"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isUserArea && currentAction == "CreateTicketPage" ? "active" : "")">
                            <i class="bi bi-ticket-perforated me-2"></i>
                            <span>Create Trip Ticket</span>
                        </a>

                        <a asp-controller="User" asp-action="TripSchedule"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isUserArea && currentAction == "TripSchedule" ? "active" : "")">
                            <i class="bi bi-calendar-check me-2"></i>
                            <span>Trip Schedule</span>
                        </a>

                        <a asp-controller="User" asp-action="ShuttleViewer"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isUserArea && currentAction == "ShuttleViewer" ? "active" : "")">
                            <i class="bi bi-bus-front me-2"></i>
                            <span>Shuttle Viewer</span>
                        </a>
                    </div>
                </div>
            </div>
        }

        @if (Model.Contains("System Settings"))
        {
            <div class="nav-item-group mb-1">
                <a href="#adminSubmenu"
                   data-bs-toggle="collapse"
                   aria-expanded="@(isUserManagementActive.ToString().ToLowerInvariant())"
                   class="nav-link-custom d-flex justify-content-between align-items-center px-3 py-2.5 rounded-3 @(isUserManagementActive ? "" : "collapsed") @(isUserManagementActive ? "active-parent" : "")">
                    <span class="d-flex align-items-center">
                        <i class="bi bi-person-fill-gear me-3 fs-5"></i>
                        <span>User Management</span>
                    </span>
                    <i class="bi bi-chevron-right submenu-arrow small"></i>
                </a>

                <div class="collapse @(isUserManagementActive ? "show" : "") mt-1 ps-3" id="adminSubmenu">
                    <div class="d-flex flex-column gap-1 border-start border-2 ps-2 my-1">
                        <a asp-controller="Admin" asp-action="Users"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isAdminArea && currentAction == "Users" ? "active" : "")">
                            <i class="bi bi-people me-2"></i>
                            <span>Users</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Groups"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isAdminArea && currentAction == "Groups" ? "active" : "")">
                            <i class="bi bi-people-fill me-2"></i>
                            <span>Group and Cluster</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Modules"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isAdminArea && currentAction == "Modules" ? "active" : "")">
                            <i class="bi bi-grid-1x2 me-2"></i>
                            <span>Modules</span>
                        </a>

                        <a asp-controller="Admin" asp-action="Access"
                           class="nav-link-sub d-flex align-items-center px-3 py-2 rounded-2 @(isAdminArea && currentAction == "Access" ? "active" : "")">
                            <i class="bi bi-key-fill me-2"></i>
                            <span>Access and Permission</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</nav>