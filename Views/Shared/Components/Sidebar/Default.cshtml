@model HashSet<string>

<nav class="sidebar-nav px-3 mt-4" aria-label="Sidebar Navigation">
    @{
        bool showRequestorMngmt = Model.Contains("Request Management");
        bool showAdminMenu = Model.Contains("Admin Dashboard");
        bool showRequestorMenu = Model.Contains("Requestor Dashboard");
        bool showGAMenu = Model.Contains("GA Dashboard");


        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        var isAdminArea = currentController == "Admin";
        var isGAArea = currentController == "GA";
        var isRequestorArea = currentController == "Request";

        var isAdminAreaActive = isAdminArea && isRequestorArea && (currentAction == "CreateTicketPage" || currentAction == "TripSchedule" || currentAction == "ShuttleViewer" ||
        currentAction == "Users" || currentAction == "Groups" || currentAction == "Modules" || currentAction == "Access");

        var isRequestorAreaActive = isRequestorArea && (currentAction == "CreateTicketPage" || currentAction == "TripSchedule" || currentAction == "ShuttleViewer");

    }

    @if (showAdminMenu)
    {
        <div class="text-uppercase text-muted px-3 mb-2" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
            Main Menu
        </div>

        <a asp-controller="Admin" asp-action="Index"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(isAdminArea && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-house-door me-3 fs-6"></i>
            <span>Dashboard</span>
        </a>



        <div class="text-uppercase text-muted px-3 mb-2 mt-4" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
            Admin Menu
        </div>
        <div class="nav-item-group mb-1">
            <a href="#adminSubmenu"
               data-bs-toggle="collapse"
               aria-expanded="@(isAdminAreaActive.ToString().ToLowerInvariant())"
               class="nav-link-custom d-flex justify-content-between align-items-center px-3 py-2 @(isAdminAreaActive ? "" : "collapsed") @(isAdminAreaActive ? "active-parent" : "")">
                <span class="d-flex align-items-center">
                    <i class="bi bi-person-fill-gear me-3 fs-6"></i>
                    <span>Account and Access</span>
                </span>
                <i class="bi bi-chevron-right submenu-arrow small"></i>
            </a>

            <div class="collapse @(isAdminAreaActive ? "show" : "") py-1" id="adminSubmenu">
                <div class="d-flex flex-column gap-1">
                    <a asp-controller="Admin" asp-action="Users"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(isAdminArea && currentAction == "Users" ? "active" : "")">
                        <span>Users</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Groups"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(isAdminArea && currentAction == "Groups" ? "active" : "")">
                        <span>Group and Cluster</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Modules"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(isAdminArea && currentAction == "Modules" ? "active" : "")">
                        <span>Modules</span>
                    </a>

                    <a asp-controller="Admin" asp-action="Access"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(isAdminArea && currentAction == "Access" ? "active" : "")">
                        <span>Access and Permission</span>
                    </a>
                </div>
            </div>
        </div>
        <a asp-controller="User" asp-action="ShuttleViewer"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(currentAction == "ShuttleViewer" ? "active" : "")">
            <i class="bi  bi-bus-front-fill me-3 fs-6"></i>
            <span>Shuttle Viewer</span>
        </a>
    }


    @if (showRequestorMenu)
    {
        <div class="text-uppercase text-muted px-3 mb-2" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
            Main Menu
        </div>

        <a asp-controller="User" asp-action="Index"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(isRequestorAreaActive && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-grid-1x2 me-3 fs-6"></i>
            <span>Dashboard</span>
        </a>

        <div class="nav-item-group mb-1">
            <a href="#requestSubmenu"
               data-bs-toggle="collapse"
               aria-expanded="@(isRequestorAreaActive.ToString().ToLowerInvariant())"
               class="nav-link-custom d-flex justify-content-between align-items-center px-3 py-2 @(isRequestorAreaActive ? "" : "collapsed") @(isRequestorAreaActive ? "active-parent" : "")">
                <span class="d-flex align-items-center">
                    <i class="bi bi-send me-3 fs-6"></i>
                    <span>Trip Ticket Request</span>
                </span>
                <i class="bi bi-chevron-right submenu-arrow small"></i>
            </a>

            <div class="collapse @(isRequestorAreaActive ? "show" : "") py-1" id="requestSubmenu">
                <div class="d-flex flex-column gap-1">
                    <a asp-controller="User" asp-action="CreateTicketPage"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(currentAction == "CreateTicketPage" ? "active" : "")">
                        <span>Create Trip Ticket</span>
                    </a>

                    <a asp-controller="User" asp-action="TripSchedule"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(currentAction == "TripSchedule" ? "active" : "")">
                        <span>Trip Schedule</span>
                    </a>
                </div>
            </div>
        </div>

        <a asp-controller="User" asp-action="ShuttleViewer"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(currentAction == "ShuttleViewer" ? "active" : "")">
            <i class="bi  bi-bus-front-fill me-3 fs-6"></i>
            <span>Shuttle Viewer</span>
        </a>
    }

    @if (showGAMenu)
    {
        <div class="text-uppercase text-muted px-3 mb-2" style="font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;">
            Main Menu
        </div>

        <a asp-controller="GA" asp-action="Index"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(isRequestorAreaActive && currentAction == "Index" ? "active" : "")">
            <i class="bi bi-grid-1x2 me-3 fs-6"></i>
            <span>Dashboard</span>
        </a>

        <div class="nav-item-group mb-1">
            <a href="#requestSubmenu"
               data-bs-toggle="collapse"
               aria-expanded="@(isRequestorAreaActive.ToString().ToLowerInvariant())"
               class="nav-link-custom d-flex justify-content-between align-items-center px-3 py-2 @(isRequestorAreaActive ? "" : "collapsed") @(isRequestorAreaActive ? "active-parent" : "")">
                <span class="d-flex align-items-center">
                    <i class="bi bi-send me-3 fs-6"></i>
                    <span>Trip Ticket Request</span>
                </span>
                <i class="bi bi-chevron-right submenu-arrow small"></i>
            </a>

            <div class="collapse @(isRequestorAreaActive ? "show" : "") py-1" id="requestSubmenu">
                <div class="d-flex flex-column gap-1">
                    <a asp-controller="User" asp-action="CreateTicketPage"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(currentAction == "CreateTicketPage" ? "active" : "")">
                        <span>Create Trip Ticket</span>
                    </a>

                    <a asp-controller="User" asp-action="TripSchedule"
                       class="nav-link-sub d-flex align-items-center py-1.5 @(currentAction == "TripSchedule" ? "active" : "")">
                        <span>Trip Schedule</span>
                    </a>
                </div>
            </div>
        </div>

        <a asp-controller="User" asp-action="ShuttleViewer"
           class="nav-link-custom d-flex align-items-center px-3 py-2 mb-1 @(currentAction == "ShuttleViewer" ? "active" : "")">
            <i class="bi  bi-bus-front-fill me-3 fs-6"></i>
            <span>Shuttle Viewer</span>
        </a>
    }
</nav>